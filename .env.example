# Porta e host do servidor
PORT=3000
HOST=0.0.0.0

# Nome exibido da sala e limite de pessoas simultâneas.
# A topologia é mesh P2P: cada pessoa envia mídia para todas as outras.
# Acima de ~10 participantes o upload de quem compartilha tela vira gargalo.
ROOM_NAME=Sala pública
MAX_PEERS=12

# STUN (padrão: servidores públicos do Google). Separe múltiplos por vírgula.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN (opcional, mas NECESSÁRIO para redes com NAT simétrico / firewall corporativo).
# Sem TURN, parte das conexões simplesmente não fecha.
# Ex.: TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
