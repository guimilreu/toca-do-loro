# Porta e host do servidor
PORT=3000
HOST=0.0.0.0

# Nome exibido da toca e limite de pessoas simultâneas.
# A topologia é mesh P2P: cada pessoa envia mídia para todas as outras.
# Acima de ~10 participantes o upload de quem compartilha tela vira gargalo.
ROOM_NAME=Toca do Loro
MAX_PEERS=12

# STUN (padrão: servidores públicos do Google). Separe múltiplos por vírgula.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN — NECESSÁRIO na prática. Sem ele, pares atrás de NAT simétrico/CGNAT
# não fecham conexão entre si (o sintoma é: todo mundo ouve uma pessoa só).
# Ex.: TURN_URLS=turn:1.2.3.4:3478?transport=udp,turn:1.2.3.4:3478?transport=tcp
TURN_URLS=

# Preferido: mesmo segredo do coturn (--use-auth-secret --static-auth-secret).
# O servidor gera credencial temporária por entrada; o segredo nunca vai ao navegador.
TURN_SECRET=

# Alternativa (pior): usuário e senha fixos do coturn — ficam visíveis no navegador.
TURN_USERNAME=
TURN_PASSWORD=
