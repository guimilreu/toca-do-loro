{
  "name": "toca-do-loro",
  "version": "1.0.0",
  "private": true,
  "description": "Uma toca só: voz e compartilhamento de tela, sem cadastro.",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "npm run test:unit && npm run test:signaling && npm run test:e2e",
    "test:signaling": "node test/signaling.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p jsconfig.json",
    "test:unit": "node --test test/unit.test.mjs"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
